{
  "name": "registro-estudiantes",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "sass src/styles/main.scss public/styles.css --no-source-map --style=compressed",
    "watch:css": "sass --watch src/styles/main.scss public/styles.css --no-source-map",
    "build": "rimraf dist && pnpm run build:css && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pnpm": "^12.10.1",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
